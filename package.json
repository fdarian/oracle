{
	"name": "oracle",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.9.0",
	"scripts": {
		"check:type": "tsrs --noEmit",
		"check:lint": "biome lint .",
		"format": "biome check --write",
		"db:generate": "drizzle-kit generate && deskkit gen-migrations",
		"build": "bun run scripts/build.ts",
		"ci:version": "changeset version && pnpm install --lockfile-only",
		"ci:release": "changeset publish"
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.5",
		"@effect/sql-libsql": "4.0.5",
		"@effect/sql-sqlite-bun": "4.0.5",
		"@libsql/client": "^0.18.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@toon-format/toon": "^2.3.0",
		"deskkit": "github:fdarian/deskkit",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.5",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@changesets/cli": "^3.0.3",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/bun": "^1.4.3",
		"@types/node": "^25.9.3",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"tsrs": "0.18.0-ts7.1.0-dev.20260929",
		"typescript": "^7.0.2"
	}
}
